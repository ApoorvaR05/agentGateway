# SENTINEL Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to source control.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "openai" | "ollama"
LLM_PROVIDER=openai

# OpenAI settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Ollama settings (used when LLM_PROVIDER=ollama — free, runs locally)
OLLAMA_MODEL=llama3
OLLAMA_BASE=http://localhost:11434

# ── Sandbox Infrastructure (defaults match docker-compose.yml) ───────────────
POSTGRES_DSN=postgresql://axiom:axiom_pass@localhost:5432/proddb
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
IAM_BASE=http://localhost:8300
NGINX_BASE=http://localhost:8080
REDIS_URL=redis://localhost:6379/0

# ── SENTINEL Risk Thresholds ─────────────────────────────────────────────────
RISK_WARN_THRESHOLD=0.40
RISK_BLOCK_THRESHOLD=0.70
DRIFT_WARN_THRESHOLD=0.35
DRIFT_BLOCK_THRESHOLD=0.55

# ── Agent Behaviour ───────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=20
AGENT_VERBOSE=true
